@page "/groupvote"
@inject PlaceService PlaceService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h2" Class="mb-4 text-center mt-8 serif-text">佛系揪團</MudText>
<MudText Typo="Typo.body1" Class="mb-10 text-center" Style="color: #707A65;">不費力氣的默契，從這裡開始。</MudText>

<MudContainer MaxWidth="MaxWidth.Small">
@if (_phase == VotePhase.Setup)
{
    <MudPaper Class="pa-8 glass-card animate-fade-in text-center" Elevation="0">
        <MudText Typo="Typo.h5" Class="mb-6 serif-text" Color="Color.Primary">
            今晚，你想如何做決定？
        </MudText>
        
        <div class="mb-8">
            <MudText Typo="Typo.subtitle1" Class="mb-6 serif-text">選擇今日的心情大類別</MudText>
            
            <div class="d-flex flex-column gap-3">
                @foreach (var theme in PlaceService.GetThemes())
                {
                    <MudButton Variant="@(_selectedTheme == theme ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="@(() => _selectedTheme = theme)"
                               Class="py-4 rounded-xl hover-lift"
                               StartIcon="@GetThemeIcon(theme)">
                        @theme
                    </MudButton>
                }
            </div>
            
            @if (!string.IsNullOrEmpty(_selectedTheme))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mt-4">
                    系統將自動為您挑選 8 種「@_selectedTheme」品項進入票選！
                </MudAlert>
            }
        </div>

        <MudNumericField @bind-Value="_playerCount" Min="1" Max="10" Label="同行人數" Variant="Variant.Outlined" Class="mb-8 mx-auto" Style="max-width: 200px;" />
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                   OnClick="StartVoting" 
                   Disabled="@(string.IsNullOrEmpty(_selectedTheme))"
                   Class="hover-lift px-8 py-3 rounded-pill" Size="Size.Large">
            開始美味海選
        </MudButton>
    </MudPaper>
}
else if (_phase == VotePhase.Voting)
{
    <div class="animate-fade-in text-center">
        @if (_playerCount > 1)
        {
            <MudText Typo="Typo.h4" Class="mb-8 serif-text" Color="Color.Primary">請第 <b>@_currentPlayerIndex</b> 位知己進行選擇</MudText>
        }
        else
        {
            <MudText Typo="Typo.h4" Class="mb-8 serif-text" Color="Color.Primary">請傾聽內心，開啟你的美味探索</MudText>
        }
        
        <MudCard Elevation="0" Class="glass-card mx-auto mb-8" Style="max-width: 500px;">
            <div class="d-flex align-center justify-center" style="height: 350px; background: linear-gradient(135deg, #FDFCF0 0%, #E9EDC9 100%);">
                <MudIcon Icon="@GetTagIcon(_currentTags[_currentCandidateIndex])" Style="font-size: 120px;" Color="Color.Primary" />
            </div>
            <MudCardContent Class="pa-6">
                <MudText Typo="Typo.h4" Class="serif-text mb-2">@_currentTags[_currentCandidateIndex]</MudText>
                <MudText Typo="Typo.body2" Style="color: #707A65;">你今天期待這個品項嗎？</MudText>
            </MudCardContent>
            <MudCardActions Class="justify-space-between px-8 pb-6 pt-2">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Large" Class="hover-lift" OnClick="() => Vote(false)" Style="border: 1px solid #D1D5CB;" />
                <MudIconButton Icon="@Icons.Material.Filled.Favorite" Color="Color.Secondary" Size="Size.Large" Class="hover-lift" OnClick="() => Vote(true)" Style="border: 1px solid #D4A373;" />
            </MudCardActions>
        </MudCard>
        
        <MudText Typo="Typo.caption" Class="mt-4" Style="letter-spacing: 2px;">探索進度: @(_currentCandidateIndex + 1) / @_currentTags.Count</MudText>
    </div>
}
else if (_phase == VotePhase.Intermission)
{
    <div class="animate-fade-in text-center">
        <MudPaper Class="pa-8 glass-card text-center mx-auto mb-8 animate-fade-in" Elevation="0" Style="max-width: 500px;">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Style="font-size: 80px;" Color="Color.Primary" Class="mb-6 pulse-animation" />
            
            <MudText Typo="Typo.h4" Class="mb-4 serif-text" Color="Color.Primary">
                第 <b>@_currentPlayerIndex</b> 位知己選擇完成！
            </MudText>
            
            <MudText Typo="Typo.body1" Class="mb-8" Style="color: #707A65; line-height: 1.8;">
                隨心流動，默契已在無聲中累積。<br />
                請將手機遞給下一位 <b>第 @(_currentPlayerIndex + 1) 位知己</b>。
            </MudText>

            <!-- 遞交進度條/狀態 -->
            <div class="d-flex justify-center align-center gap-2 mb-8 pa-4 rounded-xl" Style="background: rgba(122, 157, 84, 0.05); width: fit-content; margin: 0 auto;">
                @for (int i = 1; i <= _playerCount; i++)
                {
                    var stepNum = i;
                    if (stepNum <= _currentPlayerIndex)
                    {
                        <div class="d-flex align-center justify-center rounded-circle" Style="width: 36px; height: 36px; background-color: #7A9D54; color: white;">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        </div>
                    }
                    else if (stepNum == _currentPlayerIndex + 1)
                    {
                        <div class="d-flex align-center justify-center rounded-circle pulse-animation" Style="width: 36px; height: 36px; background-color: #D4A373; color: white; font-weight: bold;">
                            @stepNum
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center rounded-circle" Style="width: 36px; height: 36px; background-color: #E0E0E0; color: #9E9E9E;">
                            @stepNum
                        </div>
                    }
                    
                    @if (stepNum < _playerCount)
                    {
                        <div Style="width: 24px; height: 2px; background-color: @(stepNum < _currentPlayerIndex ? "#7A9D54" : "#E0E0E0");"></div>
                    }
                }
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                       OnClick="StartNextPlayer" 
                       Class="hover-lift px-8 py-4 rounded-pill" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.PlayArrow">
                我已拿到手機，開始探索
            </MudButton>
        </MudPaper>
    </div>
}
else if (_phase == VotePhase.Revealing)
{
    <div class="text-center" style="padding: 80px 0;">
        <MudText Typo="Typo.h2" Class="serif-text reveal-countdown" Style="font-size: 5rem; color: #D4A373;">
            @_revealText
        </MudText>
    </div>
}
else if (_phase == VotePhase.Result)
{
    @if (_showConfetti)
    {
        <div class="confetti-container">
            @for (int i = 0; i < 40; i++)
            {
                var left = Random.Shared.Next(0, 100);
                var delay = Random.Shared.NextDouble() * 2;
                var color = _confettiColors[Random.Shared.Next(_confettiColors.Length)];
                var size = Random.Shared.Next(6, 14);
                <div class="confetti-piece" style="left:@(left)%;animation-delay:@(delay.ToString("F1"))s;background:@color;width:@(size)px;height:@(size)px;"></div>
            }
        </div>
    }
    <div class="text-center result-bounce-in">
        @if (!string.IsNullOrEmpty(_winningTag))
        {
            <MudText Typo="Typo.h3" Class="mb-4 serif-text" Color="Color.Secondary">🎉 今天的共識是</MudText>
            <MudText Typo="Typo.h2" Class="mb-8 serif-text" Color="Color.Primary" Style="font-size: 3rem;">@_winningTag</MudText>
            
            @if (_recommendedShops.Any())
            {
                <MudText Typo="Typo.body1" Class="mb-8" Style="color: #707A65;">這附近的這些角落，正適合現在的你們：</MudText>
                
                <MudGrid Class="mb-8">
                    @foreach (var place in _recommendedShops)
                    {
                        <MudItem xs="12" sm="4">
                            <MudCard Elevation="0" Class="glass-card h-100">
                                <MudCardMedia Image="@place.ImageUrl" Height="140" />
                                <MudCardContent Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Class="serif-text">@place.Name</MudText>
                                    <MudText Typo="Typo.caption">距您約 @(place.DistanceInMeters)m</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-8 rounded-xl" Style="border-color: #7A9D54; color: #7A9D54;">
                    目前的探索半徑內較少符合的店家，但您可以點擊下方按鈕擴大地圖搜尋範圍，一定能找到驚喜！
                </MudAlert>
            }

            <div class="d-flex flex-column gap-4 align-center mb-10">
                <MudButton Href="@PlaceService.GetMapSearchUrl(_winningTag, PlaceService.UserLat, PlaceService.UserLng)" 
                           Target="_blank" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                           Class="hover-lift rounded-pill px-10 py-4" StartIcon="@Icons.Material.Filled.Map">
                    在 Google Map 探索「@_winningTag」
                </MudButton>
                
                <MudText Typo="Typo.caption" Color="Color.Default">將直接為您展開附近評分最高的店家地圖</MudText>
            </div>

            @if (_runnerUpTags.Any())
            {
                <MudDivider Class="my-8" Style="opacity: 0.3;" />
                <MudText Typo="Typo.h6" Class="mb-4 serif-text" Style="color: #707A65;">或者，這些高人氣選項也值得考慮：</MudText>
                <div class="d-flex justify-center gap-4 flex-wrap">
                    @for (int i = 0; i < _runnerUpTags.Count; i++)
                    {
                        var tag = _runnerUpTags[i];
                        var rank = i + 2;
                        <MudButton Href="@PlaceService.GetMapSearchUrl(tag, PlaceService.UserLat, PlaceService.UserLng)"
                                   Target="_blank"
                                   Variant="Variant.Outlined" 
                                   Color="Color.Secondary" 
                                   Class="hover-lift rounded-pill px-6 py-2"
                                   StartIcon="@(rank == 2 ? Icons.Material.Filled.LooksTwo : Icons.Material.Filled.Looks3)">
                            @tag
                        </MudButton>
                    }
                </div>
            }
        }
        <MudButton Class="mt-12 hover-lift rounded-pill px-8" Variant="Variant.Outlined" Color="Color.Primary" OnClick="Reset">重新開始</MudButton>
    </div>
}
</MudContainer>

@code {
    private enum VotePhase { Setup, Voting, Intermission, Revealing, Result }
    private VotePhase _phase = VotePhase.Setup;
    
    private string _selectedTheme = "正餐";
    private int _playerCount = 2;
    private int _currentPlayerIndex = 1;
    private int _currentCandidateIndex = 0;
    
    private bool _showConfetti = false;
    private string _revealText = "";
    private string[] _confettiColors = { "#7A9D54", "#D4A373", "#E9EDC9", "#F9A825", "#FF7043", "#AB47BC" };

    private List<string> _currentTags = new();
    private string? _winningTag;
    private List<string> _runnerUpTags = new();
    private List<Place> _recommendedShops = new();
    private Dictionary<string, int> _voteTally = new();

    protected override async Task OnInitializedAsync()
    {
        await PlaceService.InitializeAsync(Http);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var result = await JSRuntime.InvokeAsync<GeolocationData?>("window.getUserGeolocation");
                if (result != null)
                {
                    PlaceService.UserLat = result.Latitude;
                    PlaceService.UserLng = result.Longitude;
                }
            }
            catch { /* Fallback to default coord */ }
            finally
            {
                StateHasChanged();
            }
        }
    }

    protected override void OnInitialized()
    {
        var hour = DateTime.Now.Hour;
        if (hour >= 5 && hour < 10) _selectedTheme = "早餐";
        else if (hour >= 10 && hour < 14) _selectedTheme = "午餐";
        else if (hour >= 14 && hour < 17) _selectedTheme = "下午茶/甜點";
        else if (hour >= 17 && hour < 21) _selectedTheme = "晚餐";
        else _selectedTheme = "宵夜";
    }

    private void StartVoting()
    {
        _currentTags = PlaceService.GetItemsByTheme(_selectedTheme);
        if (!_currentTags.Any()) return;
        _voteTally = _currentTags.ToDictionary(t => t, t => 0);
        
        _currentPlayerIndex = 1;
        _currentCandidateIndex = 0;
        _phase = VotePhase.Voting;
    }

    private void Vote(bool isLike)
    {
        if (isLike)
        {
            var key = _currentTags[_currentCandidateIndex];
            _voteTally[key]++;
        }

        _currentCandidateIndex++;
        int totalLimit = _currentTags.Count;

        if (_currentCandidateIndex >= totalLimit)
        {
            if (_currentPlayerIndex >= _playerCount)
            {
                _ = RevealResult();
            }
            else
            {
                _phase = VotePhase.Intermission;
            }
        }
    }

    private void StartNextPlayer()
    {
        _currentPlayerIndex++;
        _currentCandidateIndex = 0;
        _phase = VotePhase.Voting;
    }

    private async Task RevealResult()
    {
        // Calculate result first
        if (!_voteTally.Any()) return;

        var random = new Random();
        // Sort tags by votes descending, then randomly for ties
        var sortedTags = _voteTally.OrderByDescending(kv => kv.Value).ThenBy(kv => random.Next()).Select(kv => kv.Key).ToList();

        _winningTag = sortedTags.FirstOrDefault();
        _runnerUpTags = sortedTags.Skip(1).Take(2).ToList();

        _recommendedShops = PlaceService.GetMatchesByTag(_winningTag!, PlaceService.UserLat, PlaceService.UserLng);

        // Dramatic countdown
        _phase = VotePhase.Revealing;
        
        _revealText = "3";
        StateHasChanged();
        await Task.Delay(800);
        
        _revealText = "2";
        StateHasChanged();
        await Task.Delay(800);
        
        _revealText = "1";
        StateHasChanged();
        await Task.Delay(800);
        
        _revealText = "🎉";
        StateHasChanged();
        await Task.Delay(500);

        // Show result with confetti
        _showConfetti = true;
        _phase = VotePhase.Result;
        StateHasChanged();

        // Hide confetti after 4 seconds
        await Task.Delay(4000);
        _showConfetti = false;
        StateHasChanged();
    }

    private void Reset()
    {
        _showConfetti = false;
        _winningTag = null;
        _runnerUpTags.Clear();
        _phase = VotePhase.Setup;
    }

    private string GetThemeIcon(string theme)
    {
        return theme switch
        {
            "早餐" => Icons.Material.Filled.BakeryDining,
            "午餐" => Icons.Material.Filled.LunchDining,
            "晚餐" => Icons.Material.Filled.DinnerDining,
            "宵夜" => Icons.Material.Filled.Nightlife,
            "下午茶/甜點" => Icons.Material.Filled.EmojiFoodBeverage,
            "異國/特色" => Icons.Material.Filled.FlightTakeoff,
            _ => Icons.Material.Filled.Category
        };
    }

    private string GetTagIcon(string tag)
    {
        return tag switch
        {
            "牛肉麵" or "拉麵" or "烏龍麵" or "蕎麥麵" or "越南河粉" or "涼麵" or "炒麵" => Icons.Material.Filled.RamenDining,
            "滷肉飯" or "丼飯" or "烤肉飯" or "石鍋拌飯" or "炒飯" or "豬排飯" or "鰻魚飯" or "控肉飯" or "雞肉飯" or "肉燥飯" => Icons.Material.Filled.RiceBowl,
            "火鍋" or "麻辣鍋" or "酸菜白肉鍋" or "羊肉爐" or "薑母鴨" or "壽喜燒" => Icons.Material.Filled.SoupKitchen,
            "熱炒" or "義大利麵" or "鐵板燒" or "客家小炒" or "海鮮餐廳" or "義式燉飯" or "西班牙海鮮燉飯" => Icons.Material.Filled.DinnerDining,
            "牛排" or "法式料理" => Icons.Material.Filled.RoomService,
            "壽司" or "生魚片" or "夏威夷拌飯" => Icons.Material.Filled.Phishing,
            "漢堡" or "美式餐廳" => Icons.Material.Filled.LunchDining,
            "素食/蔬食" or "健康餐" or "沙拉" or "素食吃到飽" => Icons.Material.Filled.LocalFlorist,
            "早午餐" => Icons.Material.Filled.BreakfastDining,
            "茶餐廳" or "自助餐" or "便當" or "燒臘" => Icons.Material.Filled.Storefront,
            "水餃" or "小籠包" or "蒸餃" or "鍋貼" => Icons.Material.Filled.Tapas,
            
            "臭豆腐" => Icons.Material.Filled.LocalFireDepartment,
            "鹹酥雞" or "雞排" or "炸雞" or "地瓜薯條" or "炸魷魚" => Icons.Material.Filled.Fastfood,
            "燒烤" or "串燒" or "烤香腸" or "烤玉米" or "串燒居酒屋" => Icons.Material.Filled.KebabDining,
            "滷味" or "鹽水雞" or "麻辣燙" => Icons.Material.Filled.TakeoutDining,
            "刈包" or "生煎包" or "胡椒餅" or "雙胞胎" or "燒餅油條" => Icons.Material.Filled.BakeryDining,
            "蔥油餅" or "韭菜盒" or "蛋餅" or "蘿蔔糕" => Icons.Material.Filled.PieChart,
            "肉羹" or "四神湯" or "關東煮" or "豬血湯" or "貢丸湯" or "蛤蜊湯" or "砂鍋粥" => Icons.Material.Filled.SoupKitchen,
            "米糕" or "清粥小菜" or "飯糰" => Icons.Material.Filled.RiceBowl,

            "咖啡" or "海景咖啡" or "老宅咖啡" => Icons.Material.Filled.Coffee,
            "貓咪咖啡廳" => Icons.Material.Filled.Pets,
            "甜點" or "蛋糕" or "千層蛋糕" or "生乳捲" or "提拉米蘇" or "布朗尼" => Icons.Material.Filled.Cake,
            "鬆餅" or "司康" or "可麗露" or "可頌" or "法式吐司" or "蜜糖吐司" => Icons.Material.Filled.BakeryDining,
            "馬卡龍" or "車輪餅" => Icons.Material.Filled.Cookie,
            "冰品" or "刨冰" or "雪花冰" or "水果冰" or "芒果冰" or "綿綿冰" or "布丁" => Icons.Material.Filled.Icecream,
            "茶" or "花草茶" or "抹茶" => Icons.Material.Filled.EmojiFoodBeverage,
            "珍珠奶茶" or "手搖飲" or "果汁" or "氣泡飲" or "冰沙" => Icons.Material.Filled.LocalDrink,
            "特色酒吧" or "微醺特調" or "精釀啤酒" => Icons.Material.Filled.WineBar,
            "紅豆湯" or "綠豆湯" or "花生湯" or "燒仙草" or "熱仙草" or "地瓜湯" => Icons.Material.Filled.SoupKitchen,
            "書店" or "獨立書店" => Icons.Material.Filled.MenuBook,
            "桌遊店" => Icons.Material.Filled.Casino,
            _ => Icons.Material.Filled.AutoAwesome
        };
    }
}
